<%init>
	my %s = %HTML::Mason::Commands::session;

	my $C = $s{C};
	my $A = $s{A};
	my $debug = $s{debug};

	my $perm    = $s{perm};
	my $cgi     = $C->{CGI};

	my @order_itms = ();

	foreach my $d (@{ $s{odat}->{item_rows} }) {
		my %linedat = ();
		foreach (sort keys %{$d}) {
			next if /^option\_.+/ or /^discount/;
			$linedat{$_} = $d->{$_};
		}
		push(@order_itms, \%linedat);
	}

	# ---------- $r->content_type('text/plain; charset=utf-8');
</%init>
<?xml version="1.0" encoding="utf-8"?>
