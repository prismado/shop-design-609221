<ORDERRESPONSE
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.opentrans.org/XMLSchema/2.1" version="2.1">
    <ORDERRESPONSE_HEADER>
        <ORDERRESPONSE_INFO>
            <ORDER_ID><% $s{edi_order_id} %></ORDER_ID>
            <ORDERRESPONSE_DATE><% $C->now(7) %>T<% $C->now(6) %></ORDERRESPONSE_DATE>
            <SUPPLIER_ORDER_ID><% $s{order_id} %></SUPPLIER_ORDER_ID>
        </ORDERRESPONSE_INFO>
    </ORDERRESPONSE_HEADER>

    <ORDERRESPONSE_ITEM_LIST>
        <ORDERRESPONSE_ITEM>
% foreach my $d (@order_itms) {
%	next unless $d->{prod_id};
%	my $gtin = $C->query("select `description` from products_feat where product_id=$d->{prod_id} and featkey='GTIN' limit 1")->[0];

			<PRODUCT_ID>
				<!-- <% $d->{count} %> x Prod-ID <% $d->{prod_id} %> <% $C->web_enc($d->{title}) %> -->
				<SUPPLIER_PID xmlns="http://www.bmecat.org/bmecat/2005"><% $d->{prod_id} %></SUPPLIER_PID>
				<INTERNATIONAL_PID
					xmlns="http://www.bmecat.org/bmecat/2005"><% $gtin %>
				</INTERNATIONAL_PID>
			</PRODUCT_ID>
			<QUANTITY><% $d->{count} %></QUANTITY>
% }

            <DELIVERY_DATE>
                <DELIVERY_START_DATE><% $C->now(7, 86400) %></DELIVERY_START_DATE>
                <DELIVERY_END_DATE><% $C->now(7, 86400 * 2) %></DELIVERY_END_DATE>
            </DELIVERY_DATE>

        </ORDERRESPONSE_ITEM>
    </ORDERRESPONSE_ITEM_LIST>

</ORDERRESPONSE>
