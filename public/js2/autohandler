<%init>
	# -- Layout / Controller-Vorlauf

	use App::MVC;
	use utf8;
	use ScreenPoint::Core;
	use CGI	qw(-utf8);

	my $mvc	= App::MVC->new($r, $m);
	my $C	= ScreenPoint::Core->new($r, $m);

	my $perm   = $C->get_user_perm();
	my $this   = $mvc->this;
	my $router = $mvc->router(perm=>$perm, controllerPrefix=>'__Controller/js2', sameDir=>1); # -- $router->{controller}

	my $cgi	= CGI->new;

	$r->pnotes('app' => {
		auth =>	{ perm => $perm	},
		cgi  =>	$cgi,
		C    =>	$C,
	    }
	);

	my %controller_result;

	my $vs;
	my $noti;
	my $prism_roles;

	my @breadcrumb = (
		{ title	=> 'Status',  link => '/status'	 },
		{ title	=> 'Support', link => '/support' }
	);

	eval { $m->scomp($router->{controller},	result => \%controller_result);	};
	my $errstr = $@;
	if ($errstr) {
		$errstr	= "Warning W512302: $errstr";
	}
</%init>
